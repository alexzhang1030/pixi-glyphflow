{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": true,
  "jsdoc": true,
  "ignorePatterns": [
    ".agents/**",
    "AGENTS.md",
    "benchmarks/results/**",
    "benchmarks/shaping-simd/wasm/**/*.js",
    "dist/**",
    "bun.lock"
  ]
}
