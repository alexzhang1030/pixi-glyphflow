{
  "name": "pixi-glyphflow",
  "version": "1.2.0",
  "description": "A million-label text layer for PixiJS with instanced WebGL/WebGPU rendering.",
  "keywords": [
    "glyph-atlas",
    "harfbuzz",
    "msdf",
    "pixi-viewport",
    "pixijs",
    "rendering",
    "text",
    "webgl",
    "webgpu"
  ],
  "homepage": "https://github.com/alexzhang1030/pixi-glyphflow#readme",
  "bugs": {
    "url": "https://github.com/alexzhang1030/pixi-glyphflow/issues"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexzhang1030/pixi-glyphflow.git"
  },
  "workspaces": [
    "site"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./advanced": {
      "types": "./dist/advanced/index.d.ts",
      "import": "./dist/advanced/index.js"
    },
    "./prebuilt": {
      "types": "./dist/prebuilt/index.d.ts",
      "import": "./dist/prebuilt/index.js"
    },
    "./shaping": {
      "types": "./dist/shaping/index.d.ts",
      "import": "./dist/shaping/index.js"
    },
    "./outline": {
      "types": "./dist/render/outline/index.d.ts",
      "import": "./dist/render/outline/index.js"
    },
    "./hb-gpu": {
      "types": "./dist/hb-gpu/index.d.ts",
      "import": "./dist/hb-gpu/index.js"
    },
    "./viewport": {
      "types": "./dist/viewport/index.d.ts",
      "import": "./dist/viewport/index.js"
    },
    "./accessibility": {
      "types": "./dist/accessibility/index.d.ts",
      "import": "./dist/accessibility/index.js"
    },
    "./text-worker.js": "./dist/worker/text-worker.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "baseline": "bun benchmarks/baseline.ts",
    "benchmark": "bun benchmarks/index.ts",
    "benchmark:workload": "bun benchmarks/harness-launcher.ts",
    "benchmark:report": "bun benchmarks/report.ts",
    "benchmark:check": "bun benchmarks/budgets.ts",
    "benchmark:core": "bun benchmarks/layer.ts",
    "benchmark:hb-gpu": "bun benchmarks/hb-gpu/run.ts",
    "benchmark:hb-gpu-browser": "bun benchmarks/hb-gpu/browser-run.ts",
    "benchmark:hb-gpu-wasm": "bun benchmarks/hb-gpu/wasm-browser-run.ts",
    "benchmark:label-collision-repeatability": "bun benchmarks/label-collision-repeatability.ts",
    "benchmark:shaping-simd": "bun benchmarks/shaping-simd/run.ts",
    "benchmark:shaping-simd-worker": "bun benchmarks/shaping-simd/worker-browser-run.ts",
    "benchmark:shaping-transport": "bun benchmarks/shaping-transport/run.ts",
    "benchmark:sparse-strips": "bun benchmarks/sparse-glyph-strips.ts",
    "benchmark:store": "bun benchmarks/store.ts",
    "benchmark:symbol-continuity": "bun benchmarks/symbol-continuity.ts",
    "build": "tsdown",
    "build:hb-gpu-wasm": "bun scripts/build-hb-gpu-wasm.ts",
    "build:harfbuzz-shaping-wasm": "bun scripts/build-harfbuzz-shaping-wasm.ts",
    "dev": "tsdown --watch",
    "docs:check": "bun scripts/docs-check.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:browser": "bun run build && playwright test",
    "test:coverage": "bun test --coverage",
    "audit": "bun audit --audit-level=high",
    "package:lint": "publint",
    "package:types": "NPM_CONFIG_CACHE=/tmp/pixi-glyphflow-npm-cache attw --pack . --profile esm-only",
    "package:smoke": "bun scripts/package-smoke.ts",
    "playground:build": "bun run build && tsc -p playground/tsconfig.json --noEmit && vite build playground",
    "playground:dev": "vite playground",
    "smoke:harfbuzz": "bun scripts/harfbuzz-smoke.ts",
    "smoke:worker": "bun run build && bun scripts/worker-smoke.ts",
    "site:build": "bun run --cwd site build",
    "site:dev": "bun run --cwd site dev",
    "site:generate": "bun run --cwd site generate",
    "site:test": "bun run site:build && bun run --cwd site test:browser",
    "site:typecheck": "bun run --cwd site typecheck",
    "package:dry-run": "NPM_CONFIG_CACHE=/tmp/pixi-glyphflow-npm-cache npm pack --dry-run",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run docs:check && bun test && bun run build && bun run package:lint && bun run package:types",
    "release:check": "bun run check && bun run test:browser && bun run benchmark:check && bun run playground:build && bun run audit && bun run smoke:worker && bun run package:smoke && bun run package:dry-run",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@zappar/msdf-generator": "1.2.4",
    "harfbuzzjs": "1.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "pixi-viewport": "6.0.3",
    "pixi.js": "8.19.0",
    "publint": "0.3.23",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "peerDependencies": {
    "pixi-viewport": "^6.0.3",
    "pixi.js": "^8.19.0"
  },
  "peerDependenciesMeta": {
    "pixi-viewport": {
      "optional": true
    }
  },
  "packageManager": "bun@1.3.14"
}
